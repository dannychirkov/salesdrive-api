{
  "name": "salesdrive-api",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @dannychirkov/salesdrive-api-client && npm run build -w @dannychirkov/salesdrive-transport-fetch && npm run build -w @dannychirkov/salesdrive-mcp-server",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "type-check": "npm run build && npm run type-check --workspaces --if-present",
    "lint": "eslint packages/*/src/**/*.ts",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
